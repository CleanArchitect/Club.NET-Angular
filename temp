ctor(initFilter)

effect(initData)
effect(initPaginator)
effect(initSort)

initData
	datasource.data = data
	paginator.length = data.length

initPaginator
	paginator.length = data.length
	paginator.size = config.size
	paginator.subscribe()
	datasource.paginator = server-side ? null : paginator

initSort				
	sort.active = config.active		
	sort.direction = config.direction
	sort.subscribe()
	datasource.sort = server-side ? null : sort

initFilter
	datasource.filter = server-side ? null : predicate
	filter.subscribe()
